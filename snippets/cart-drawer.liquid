<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.general.title' | t }}</h2>
      <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>
      <p class="cart-drawer__empty">{{ 'cart.general.empty' | t }}</p>
    </div>

    <div class="cart-drawer__footer" data-cart-drawer-footer hidden>
      <div class="cart-summary__row">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
      </div>
      <p class="cart-summary__note">{{ 'cart.general.taxes_and_shipping' | t }}</p>
      <a class="btn btn--dark" href="{{ routes.cart_url }}" style="width:100%;margin-bottom:0.75rem;">
        View cart
      </a>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--filled" style="width:100%;">
          {{ 'cart.general.checkout' | t }}
        </button>
      </form>
    </div>
  </aside>
</div>
