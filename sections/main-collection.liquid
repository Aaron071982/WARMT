<section class="collection-hero">
  <div class="page-width">
    <h1 class="collection-hero__title h1">
      {{ section.settings.heading | default: collection.title | default: 'THE COLLECTION.' }}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="collection-hero__sub">{{ section.settings.subheading }}</p>
    {%- elsif collection.description != blank -%}
      <div class="collection-hero__sub">{{ collection.description }}</div>
    {%- else -%}
      <p class="collection-hero__sub">Engineered for comfort.</p>
    {%- endif -%}
    <p class="body-xs text-muted" style="margin-top:1.25rem;">
      {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
    </p>
  </div>
</section>

<section class="collection-grid-section">
  <div class="page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid grid--2 grid--3">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" style="margin-top:3rem;display:flex;gap:1rem;justify-content:center;" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="btn btn--dark" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a class="btn btn--dark" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p>{{ 'collections.general.empty' | t }}</p>
          <div class="grid grid--2 grid--3" style="margin-top:2rem;">
            {%- for i in (1..3) -%}
              <div class="product-card">
                <div class="product-card__media">
                  <div class="product-card__placeholder">
                    <img src="{{ 'ph-product-placeholder.svg' | asset_url }}" alt="" width="400" height="500" loading="lazy">
                  </div>
                </div>
                <h3 class="product-card__title">Coming soon</h3>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom heading",
      "info": "Leave blank to use collection title"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Engineered for comfort."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}
