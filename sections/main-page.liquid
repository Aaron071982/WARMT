<section class="page-shell">
  <div class="page-width">
    <h1 class="page-shell__title h2">{{ page.title }}</h1>
    <div class="page-shell__content rte">
      {%- if page.content != blank -%}
        {{ page.content }}
      {%- else -%}
        <p>
          This page is ready for your content. Edit it in Shopify Admin → Pages.
        </p>
        <div class="page-placeholder-note">
          Placeholder: do not invent company addresses, certifications, warranties, or legal policies.
          Replace this section with verified business information before launch.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
