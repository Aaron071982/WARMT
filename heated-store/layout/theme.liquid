<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'icon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'icon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'editorial.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}
    {{ 'inventory.css' | asset_url | stylesheet_tag }}
    {%- if settings.enable_motion != false -%}
      {{ 'frostbyt-motion.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'media-controller.js' | asset_url }}" defer></script>
    <script src="{{ 'privacy-controls.js' | asset_url }}" defer></script>
    {%- if settings.enable_motion != false -%}
      <script>
        window.frostbytMotion = { enabled: true, snow: {% if settings.enable_snow == false %}false{% else %}true{% endif %} };
      </script>
      <script src="{{ 'frostbyt-motion.js' | asset_url }}" defer></script>
    {%- endif -%}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.theme = {
        routes: {
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: 'Unable to update cart'
        },
        moneyFormat: {{ shop.money_format | json }},
        cartDrawer: {{ settings.cart_drawer_enable | json }}
      };
    </script>

    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-soft-black: {{ settings.color_soft_black }};
        --color-white: {{ settings.color_text }};
        --color-editorial: {{ settings.color_editorial }};
        --color-muted: {{ settings.color_muted }};
        --color-light-gray: {{ settings.color_light_gray }};
        --color-heat: {{ settings.color_heat }};
        --color-amber: {{ settings.color_amber }};
        --color-deep-heat: {{ settings.color_deep_heat }};
        --page-width: {{ settings.page_width }}px;
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading: {% if settings.font_heading == 'sans' %}'DM Sans', system-ui, sans-serif{% else %}'Cormorant Garamond', 'Times New Roman', serif{% endif %};
        --font-body: 'DM Sans', system-ui, sans-serif;
        --header-height: 5.5rem;
      }
    </style>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_drawer_enable %}
      {% render 'cart-drawer' %}
    {% endif %}

    {% render 'cookie-banner' %}

    <div id="CartToast" class="cart-toast" hidden role="status" aria-live="polite"></div>
  </body>
</html>
