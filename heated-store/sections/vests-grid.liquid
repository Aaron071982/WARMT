{%- liquid
  assign heading = section.settings.heading | default: 'VESTS.'
  assign subheading = section.settings.subheading | default: 'Hover to reveal heat. Choose your color.'
  assign section_anchor = section.settings.section_id | default: 'vests' | handle
  assign black_base = 'inventory/vests/black-vestunglow.png' | asset_url
  assign black_glow = 'inventory/vests/black-vestglow.png' | asset_url
  assign red_base = 'inventory/vests/red-vestunglow.png' | asset_url
  assign red_glow = 'inventory/vests/red-vestglow.png' | asset_url
  assign blue_base = 'inventory/vests/blue-vestunglow.png' | asset_url
  assign blue_glow = 'inventory/vests/blue-vestglow.png' | asset_url
-%}

<section class="inventory-section inventory-section--vests" id="{{ section_anchor }}" data-inventory-section>
  <div class="page-width">
    <header class="inventory-section__header">
      <h2 class="inventory-section__title h2">{{ heading }}</h2>
      {%- if subheading != blank -%}
        <p class="inventory-section__sub">{{ subheading }}</p>
      {%- endif -%}
    </header>

    <div class="inventory-grid">
      {% render 'inventory-card',
        title: 'Heated Vest',
        color: 'black',
        url: section.settings.black_link | default: '#product-vest-black',
        image_base: black_base,
        image_glow: black_glow,
        price_label: section.settings.price_label,
        heat_label: 'Collar & core'
      %}
      {% render 'inventory-card',
        title: 'Heated Vest',
        color: 'red',
        url: section.settings.red_link | default: '#product-vest-red',
        image_base: red_base,
        image_glow: red_glow,
        price_label: section.settings.price_label,
        heat_label: 'Collar & core'
      %}
      {% render 'inventory-card',
        title: 'Heated Vest',
        color: 'blue',
        url: section.settings.blue_link | default: '#product-vest-blue',
        image_base: blue_base,
        image_glow: blue_glow,
        price_label: section.settings.price_label,
        heat_label: 'Collar & core'
      %}
    </div>

    {%- if section.settings.show_hint -%}
      <p class="inventory-section__hint">Hover to reveal heat. Click to explore every view.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vests grid",
  "tag": "section",
  "class": "section-vests-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VESTS."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hover to reveal heat. Choose your color."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section anchor ID",
      "default": "vests"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Select color"
    },
    {
      "type": "url",
      "id": "black_link",
      "label": "Black vest link"
    },
    {
      "type": "url",
      "id": "red_link",
      "label": "Red vest link"
    },
    {
      "type": "url",
      "id": "blue_link",
      "label": "Blue vest link"
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "Show interaction hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Vests grid"
    }
  ]
}
{% endschema %}
