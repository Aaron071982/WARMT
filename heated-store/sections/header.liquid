{%- liquid
  assign transparent = false
  if section.settings.transparent_on_home and template.name == 'index'
    assign transparent = true
  endif
-%}

<header
  class="site-header"
  data-site-header
  data-transparent="{{ transparent }}"
>
  <div class="site-header__inner">
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: settings.logo_width
          | image_tag:
            class: 'site-header__logo-img',
            alt: settings.brand_name | default: shop.name,
            widths: '120, 180, 240, 360',
            loading: 'eager'
        }}
      {%- else -%}
        <img
          class="site-header__logo-img"
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ settings.brand_name | default: 'Frostbyt' | escape }}"
          width="{{ settings.logo_width | default: 220 }}"
          height="110"
          loading="eager"
        >
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list list-reset">
        {%- if section.settings.menu != blank -%}
          {%- for link in section.settings.menu.links -%}
            <li>
              <a class="site-header__nav-link" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a class="site-header__nav-link" href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a class="site-header__nav-link" href="{% if template.name == 'index' %}#jackets{% else %}{{ routes.root_url }}#jackets{% endif %}">Jackets</a></li>
          <li><a class="site-header__nav-link" href="{% if template.name == 'index' %}#gloves{% else %}{{ routes.root_url }}#gloves{% endif %}">Gloves</a></li>
          <li><a class="site-header__nav-link" href="{% if template.name == 'index' %}#vests{% else %}{{ routes.root_url }}#vests{% endif %}">Vests</a></li>
          {%- if pages["our-technology"] != empty -%}<li><a class="site-header__nav-link" href="/pages/our-technology">Our Technology</a></li>{%- endif -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if section.settings.show_search -%}
        <a class="icon-btn" href="{{ routes.search_url }}" aria-label="{{ 'general.accessibility.search' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="{{ 'general.accessibility.account' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/>
          </svg>
        </a>
      {%- endif -%}

      <a
        class="icon-btn icon-btn--cart"
        href="{{ routes.cart_url }}"
        data-cart-open
        aria-label="{{ 'general.accessibility.cart' | t }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 8h12l-1 11H7L6 8z"/><path d="M9 8a3 3 0 016 0"/>
        </svg>
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <button
        type="button"
        class="icon-btn menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="MobileNav"
        aria-label="{{ 'general.accessibility.menu' | t }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="MobileNav" data-mobile-nav aria-label="Mobile">
  <button type="button" class="icon-btn mobile-nav__close" data-mobile-nav-close aria-label="{{ 'general.accessibility.close' | t }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>
  <ul class="mobile-nav__list list-reset">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <li><a class="mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    {%- else -%}
      <li><a class="mobile-nav__link" href="{{ routes.all_products_collection_url }}">Shop</a></li>
      <li><a class="mobile-nav__link" href="{% if template.name == 'index' %}#jackets{% else %}{{ routes.root_url }}#jackets{% endif %}">Jackets</a></li>
      <li><a class="mobile-nav__link" href="{% if template.name == 'index' %}#gloves{% else %}{{ routes.root_url }}#gloves{% endif %}">Gloves</a></li>
      <li><a class="mobile-nav__link" href="{% if template.name == 'index' %}#vests{% else %}{{ routes.root_url }}#vests{% endif %}">Vests</a></li>
      {%- if pages["our-technology"] != empty -%}<li><a class="mobile-nav__link" href="/pages/our-technology">Our Technology</a></li>{%- endif -%}
    {%- endif -%}
  </ul>
</nav>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Transparent header on homepage",
      "default": true
    }
  ]
}
{% endschema %}
