<footer class="site-footer">
  <div class="page-width site-footer__grid">
    <div class="site-footer__brand-col">
      <div class="site-footer__brand">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 280
            | image_tag:
              class: 'site-footer__logo-img',
              alt: settings.brand_name | default: shop.name,
              widths: '180, 240, 320',
              height: auto,
              loading: 'lazy'
          }}
        {%- else -%}
          <img
            class="site-footer__logo-img"
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ settings.brand_name | default: 'Frostbyt' | escape }}"
            width="220"
            height="110"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <p class="site-footer__tagline">{{ settings.brand_tagline }}</p>
      <p class="site-footer__seller">
        {%- if settings.legal_business_name != blank -%}
          {{ settings.legal_business_name }}
          {%- if settings.legal_business_address != blank -%}<br>{{ settings.legal_business_address | newline_to_br }}{%- endif -%}
        {%- else -%}
          <span class="site-footer__missing">Seller identification: add legal business name in Theme settings before launch.</span>
        {%- endif -%}
      </p>
    </div>

    <div>
      <h2 class="site-footer__heading">Support</h2>
      <ul class="site-footer__list list-reset">
        <li><a class="site-footer__link" href="/pages/contact">Contact</a></li>
        <li><a class="site-footer__link" href="/pages/shipping-and-delivery">Shipping &amp; Delivery</a></li>
        <li><a class="site-footer__link" href="/pages/returns-refunds-exchanges">Returns &amp; Refunds</a></li>
        <li><a class="site-footer__link" href="/pages/warranty">Warranty</a></li>
        <li><a class="site-footer__link" href="/pages/accessibility">Accessibility</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Product</h2>
      <ul class="site-footer__list list-reset">
        <li><a class="site-footer__link" href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a class="site-footer__link" href="/pages/our-technology">Our Technology</a></li>
        <li><a class="site-footer__link" href="/pages/product-safety-and-care">Safety &amp; Care</a></li>
        <li><a class="site-footer__link" href="/pages/about">About</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Legal &amp; Privacy</h2>
      <ul class="site-footer__list list-reset">
        <li><a class="site-footer__link" href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a class="site-footer__link" href="/pages/cookie-policy">Cookie Policy</a></li>
        <li><a class="site-footer__link" href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a class="site-footer__link" href="/pages/privacy-choices">Your Privacy Choices</a></li>
        <li>
          <button type="button" class="site-footer__link site-footer__link--button" data-privacy-open-prefs>
            Cookie Preferences
          </button>
        </li>
      </ul>

      {%- if settings.social_instagram != blank or settings.social_x != blank or settings.social_youtube != blank -%}
        <h2 class="site-footer__heading" style="margin-top:2rem;">Follow</h2>
        <ul class="site-footer__list list-reset">
          {%- if settings.social_instagram != blank -%}
            <li><a class="site-footer__link" href="{{ settings.social_instagram }}">Instagram</a></li>
          {%- endif -%}
          {%- if settings.social_x != blank -%}
            <li><a class="site-footer__link" href="{{ settings.social_x }}">X</a></li>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <li><a class="site-footer__link" href="{{ settings.social_youtube }}">YouTube</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. {{ section.settings.copyright_text }}</span>
    <span>{{ powered_by_link }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    }
  ]
}
{% endschema %}
