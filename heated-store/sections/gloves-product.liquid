{% render 'showcase-product',
  product: section.settings.product,
  kind: 'gloves',
  id_prefix: 'product-gloves-',
  default_color: section.settings.default_color,
  blurb: section.settings.description,
  fallback_title: 'Heated Gloves'
%}

{% schema %}
{
  "name": "Gloves product",
  "tag": "section",
  "class": "section-gloves-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Variants, prices, stock and Add to cart come from this product."
    },
    {
      "type": "select",
      "id": "default_color",
      "label": "Default color",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "pink",
          "label": "Pink"
        }
      ],
      "default": "black"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short intro",
      "default": "Rechargeable heated gloves that warm the back of your hand and your fingers, with 3 heat levels on the digital display.",
      "info": "Keep this consistent with the product listing. Full product description shows below the buy box."
    }
  ],
  "presets": [
    {
      "name": "Gloves product"
    }
  ]
}
{% endschema %}
