[
  {
    "name": "theme_info",
    "theme_name": "Frostbyt",
    "theme_version": "1.1.0",
    "theme_author": "Frostbyt",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Frostbyt"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 4,
        "unit": "px",
        "label": "Logo width",
        "default": 220
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "textarea",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "Cold is the environment. Warmth is the experience."
      },
      {
        "type": "text",
        "id": "legal_business_name",
        "label": "Legal business name",
        "info": "Shown in the footer when provided. Leave blank until verified."
      },
      {
        "type": "textarea",
        "id": "legal_business_address",
        "label": "Business / contact address",
        "info": "Shown in the footer when provided. Leave blank until verified."
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "info": "Customer-facing support contact once monitored."
      },
      {
        "type": "text",
        "id": "privacy_email",
        "label": "Privacy email",
        "info": "Privacy-request destination once monitored."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background black",
        "default": "#0B0B0B"
      },
      {
        "type": "color",
        "id": "color_soft_black",
        "label": "Soft black",
        "default": "#171717"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Pure white",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_editorial",
        "label": "Editorial off-white",
        "default": "#FAFAF8"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted gray",
        "default": "#8A8A8A"
      },
      {
        "type": "color",
        "id": "color_light_gray",
        "label": "Light gray",
        "default": "#E9E9E9"
      },
      {
        "type": "color",
        "id": "color_heat",
        "label": "Primary heat orange",
        "default": "#FF5A1F"
      },
      {
        "type": "color",
        "id": "color_amber",
        "label": "Warm amber",
        "default": "#FFB347"
      },
      {
        "type": "color",
        "id": "color_deep_heat",
        "label": "Deep heat red",
        "default": "#D62828"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_heading",
        "label": "Heading font",
        "options": [
          {
            "value": "editorial",
            "label": "Editorial (Cormorant Garamond + fallbacks)"
          },
          {
            "value": "sans",
            "label": "Modern sans (DM Sans + fallbacks)"
          }
        ],
        "default": "editorial"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 120,
        "step": 2,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 110,
        "step": 1,
        "unit": "%",
        "label": "Body scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1440
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_enable",
        "label": "Enable cart drawer",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X / Twitter URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Product defaults",
    "settings": [
      {
        "type": "textarea",
        "id": "shipping_info_default",
        "label": "Default shipping information"
      },
      {
        "type": "textarea",
        "id": "returns_info_default",
        "label": "Default returns information"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_motion",
        "label": "Enable Frostbyt motion effects",
        "default": true,
        "info": "Frost-to-heat hero intro, scroll heat bar, thermal card scans, letter reveals, cursor glow and add-to-cart embers. Visitors who prefer reduced motion get a calm version automatically."
      },
      {
        "type": "checkbox",
        "id": "enable_snow",
        "label": "Snowfall in the hero",
        "default": true,
        "info": "Flakes melt away from the cursor."
      }
    ]
  }
]